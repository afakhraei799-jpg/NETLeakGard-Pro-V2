# GEMINI_API_KEY: کلید API سرویس Gemini جهت تحلیل هوشمند گزارش (اختیاری - فقط سمت سرور)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: آدرس پایه برنامه
APP_URL="http://localhost:3000"

# TRUST_PROXY: فقط در صورتی که برنامه پشت پروکسی معکوس مورد اعتماد (مانند Cloudflare یا Cloud Run) قرار دارد true شود
TRUST_PROXY="false"

# DNS_LEAK_DOMAIN: دامنه اختصاصی تحت کنترل مالک پروژه که رکورد NS آن به سرور Authoritative DNS اشاره می‌کند (مثال: dnsleak.example.com)
DNS_LEAK_DOMAIN=""

# DNS_COLLECTOR_API_URL: آدرس سرویس ثبت‌کننده درخواست‌های Authoritative DNS جهت دریافت لاگ واقعی Resolverها
DNS_COLLECTOR_API_URL=""

# DNS_COLLECTOR_API_TOKEN: توکن احراز هویت سرویس ثبت‌کننده Authoritative DNS (سمت سرور)
DNS_COLLECTOR_API_TOKEN=""

# ABUSEIPDB_API_KEY: کلید رسمی AbuseIPDB جهت استعلام واقعی سابقه آدرس IP (اختیاری - فقط سمت سرور)
ABUSEIPDB_API_KEY=""

# GOOGLE_SAFE_BROWSING_API_KEY: کلید رسمی Google Safe Browsing / Web Risk (اختیاری - فقط سمت سرور)
GOOGLE_SAFE_BROWSING_API_KEY=""
