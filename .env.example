# GEMINI_API_KEY: کلید API سرویس Gemini جهت تحلیل هوشمند گزارش (اختیاری - فقط سمت سرور)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: آدرس پایه برنامه
APP_URL="http://localhost:3000"

# TRUST_PROXY: فقط در صورتی که برنامه پشت پروکسی معکوس مورد اعتماد (مانند Cloudflare یا Cloud Run) قرار دارد true شود
TRUST_PROXY="false"

# DNS_LEAK_DOMAIN: دامنه اختصاصی تحت کنترل مالک پروژه که رکورد NS آن به سرور Authoritative DNS اشاره می‌کند (مثال: leak.example.com)
DNS_LEAK_DOMAIN=""

# DNS_COLLECTOR_API_URL: آدرس سرویس ثبت‌کننده درخواست‌های Authoritative DNS جهت دریافت لاگ واقعی Resolverها
DNS_COLLECTOR_API_URL=""

# DNS_COLLECTOR_API_TOKEN: توکن احراز هویت اصلی سرویس ثبت‌کننده Authoritative DNS (فقط سمت سرور)
DNS_COLLECTOR_API_TOKEN=""

# DNS_COLLECTOR_API_TOKEN_PREVIOUS: توکن قبلی جهت چرخش ایمن توکن (Token Rotation) بدون قطعی سرویس (اختیاری - فقط سمت سرور)
DNS_COLLECTOR_API_TOKEN_PREVIOUS=""

# DNS_UDP53_VERIFIED: در محیط Cloudflare Worker فقط پس از راه‌اندازی و تست واقعی شنوندهٔ UDP/53 برابر "true" شود
DNS_UDP53_VERIFIED="false"

# ABUSEIPDB_API_KEY: کلید رسمی AbuseIPDB جهت استعلام واقعی سابقه آدرس IP (اختیاری - فقط سمت سرور)
ABUSEIPDB_API_KEY=""

# GOOGLE_SAFE_BROWSING_API_KEY: کلید رسمی Google Safe Browsing / Web Risk (اختیاری - فقط سمت سرور)
GOOGLE_SAFE_BROWSING_API_KEY=""
