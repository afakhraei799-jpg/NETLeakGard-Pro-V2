# ============================================================================
# تنظیمات محیطی اختیاری (Optional Environment Variables) — NETLeakGuard Pro V2
# ============================================================================
# توجه مهم: تمامی متغیرهای این فایل ۱۰۰٪ اختیاری هستند.
# برنامه بدون تنظیم هیچ متغیری به‌طور کامل اجرا می‌شود و تست‌های مستقل شبکه
# (IP عمومی، مقایسه چندمنبعی، مشاهده مستقل DNS مرورگر، WebRTC، پورت‌ها و پینگ)
# بدون نیاز به هیچ کلید یا دامنه‌ای کار می‌کنند.
# برای جلوگیری از درخواست خودکار متغیرها توسط محیط میزبان (AI Studio)، خطوط زیر
# به‌صورت کامنت باقی مانده‌اند.
# ============================================================================

# GEMINI_API_KEY: کلید API سرویس Gemini جهت تحلیل هوشمند گزارش (اختیاری - فقط سمت سرور)
# GEMINI_API_KEY=

# APP_URL: آدرس پایه برنامه (اختیاری)
# APP_URL=

# TRUST_PROXY: فقط در صورتی که برنامه پشت پروکسی معکوس مورد اعتماد قرار دارد true شود (اختیاری - پیش‌فرض: false)
# TRUST_PROXY=false

# DNS_LEAK_DOMAIN: دامنه اختصاصی جهت تست اختیاری Authoritative DNS روی UDP/53 (اختیاری)
# DNS_LEAK_DOMAIN=

# DNS_COLLECTOR_API_URL: آدرس سرویس ثبت‌کننده درخواست‌های Authoritative DNS (اختیاری)
# DNS_COLLECTOR_API_URL=

# DNS_COLLECTOR_API_TOKEN: توکن احراز هویت سرویس ثبت‌کننده Authoritative DNS (اختیاری - فقط سمت سرور)
# DNS_COLLECTOR_API_TOKEN=

# DNS_COLLECTOR_API_TOKEN_PREVIOUS: توکن قبلی جهت چرخش ایمن توکن بدون قطعی سرویس (اختیاری - فقط سمت سرور)
# DNS_COLLECTOR_API_TOKEN_PREVIOUS=

# DNS_UDP53_VERIFIED: فقط پس از راه‌اندازی و تست عملی شنوندهٔ UDP/53 برابر true شود (اختیاری - پیش‌فرض: false)
# DNS_UDP53_VERIFIED=false

# ABUSEIPDB_API_KEY: کلید رسمی AbuseIPDB جهت استعلام سابقه آدرس IP (اختیاری - فقط سمت سرور)
# ABUSEIPDB_API_KEY=

# GOOGLE_SAFE_BROWSING_API_KEY: کلید رسمی Google Safe Browsing / Web Risk (اختیاری - فقط سمت سرور)
# GOOGLE_SAFE_BROWSING_API_KEY=

